# Copy to .env and fill only the values you want the bot to use.
# Azure OpenAI (preferred when all four values are present)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional standard OpenAI fallback
OPENAI_API_KEY=

# Optional: omit these to enter credentials securely at runtime.
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
NAUKRI_MOBILE=

# Job freshness filter. Allowed values: 1, 3, 7, 15, or 30.
NAUKRI_FRESHNESS_DAYS=1
# Naukri experience filter in whole years (0-50).
NAUKRI_EXPERIENCE_YEARS=1
# Number of result pages to visit for each configured search (1-100).
NAUKRI_MAX_PAGES=3

# Cloud API. Generate a long random value; every trigger must send it as x-api-key.
API_KEY=
NAUKRI_DATA_ROOT=/home

# Profile mapping: person 1 = Amisha, person 2 = Ankit.
# Keep credentials in the matching PERSON_<number>_* namespace so profiles cannot
# accidentally inherit another person's login.
PERSON_1_EMAIL=
PERSON_1_PASSWORD=
PERSON_1_EXPERIENCE_YEARS=3
PERSON_2_EMAIL=
PERSON_2_PASSWORD=
PERSON_2_EXPERIENCE_YEARS=4
